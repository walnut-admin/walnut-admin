# Force Unix line endings for all text files
* text=auto eol=lf

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.jsx text eol=lf

# Config / data
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.mdx text eol=lf

# Styles
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf

# Shell
*.sh text eol=lf
*.bash text eol=lf

# Dotfiles
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.npmrc text eol=lf
.prettierrc text eol=lf

# Lockfile — treat as binary to avoid merge conflicts
pnpm-lock.yaml binary
