{
  // ─────────────────────────────────────────────────────────────────────────────
  // 缓存边界（改哪个文件会让哪个 task 的缓存失效）：完整判据表见
  // apps/docs/src/zh-CN/content/monorepo/turbo-cache-boundary.md
  //
  // 判据的唯一真源是**跑出来的**，不是我们对配置的二次解读：
  //   pnpm exec turbo run <task> --dry=json → 比对各 task 的 hash；它同时给出每个 task 的
  //   `inputs`（文件 → 内容哈希）与 `globalCacheInputs`（全局哈希的构成）。
  // 机械门禁：`pnpm lint:turbo-cache`（walnut-check-turbo-cache），push 前 / CI / 发版三处都跑。
  //
  // 三条最容易踩的：
  //   ① 共享包是**源码直消费**（`exports` 指 `./src/**`）⇒「依赖包源码变了」必须让下游的
  //      `types:check` 失效 —— 这就是下面 `transit` 任务存在的原因。
  //   ② 产物目录必须逐个进 `outputs`：漏一个的后果不是报错，而是**缓存命中时静默不产出**
  //      （turbo 照报 `FULL TURBO` + exit 0，而盘上一个文件都没有）。
  //   ③ 根 `turbo.json` 按**解析后的语义**进哈希、不按文本：加一条匹配不到任何文件的排除 glob
  //      不会让任何 task 失效，而真改 `inputs` / `outputs` 会。
  // ─────────────────────────────────────────────────────────────────────────────
  "$schema": "https://turbo.build/schema.json",
  // ── 本地缓存的自动回收（Turbo 2.10+）──────────────────────────────────────────
  // 上限到了随用随回收，不必再手工清 `.turbo/cache`。
  "cacheMaxAge": "14d",
  "cacheMaxSize": "5GB",
  // 并发上限。**Turbo 的默认值是 10** —— 本仓 12 核，而 `test` 任务下每个 vitest 进程默认
  // 又会按 CPU 数开 worker ⇒ 两级并发乘起来最坏能到 10×12 个进程。
  // 收到 4 是与 `@walnut/vitest-config` 的 `maxWorkers: '50%'` **配套**的（那一条同时钉住
  // 单任务的 worker 数）—— 两级必须一起收敛，只改一级等于没改。
  "concurrency": "4",
  "boundaries": {
    "tags": {
      "shared": {
        "dependencies": {
          "deny": ["app"]
        }
      },
      "backend": {
        "dependencies": {
          "deny": ["platform-web"]
        }
      },
      "platform-any": {
        "dependencies": {
          "deny": ["platform-web", "platform-node"]
        }
      },
      "platform-node": {
        "dependencies": {
          "deny": ["platform-web"]
        }
      }
    }
  },
  // 全局哈希的构成（任何一条变了 → 全部 task 失效）：这些文件的内容 + `globalEnv` 的值 +
  // **内部依赖哈希**（根 `package.json` 依赖到的 workspace 包，其源码内容也算全局输入）。
  // 想缩小失效面就别往这里加；想扩大覆盖面优先考虑 `transit`，而不是继续堆全局条目。
  "globalDependencies": [
    "package.json",
    "tsconfig.json",
    "eslint.config.ts",
    "commitlint.config.ts",
    "knip.config.ts",
    "pnpm-workspace.yaml",
    "packages/tooling/tsconfig/*.json",
    "packages/tooling/vitest-config/*.ts"
  ],
  // ⚠️ `NODE_ENV` **刻意不放在 `globalEnv`**：它必须**可见**（Turbo 的严格模式会剥离未声明的
  // 变量，而它不在内置放行名单里），但**不该进哈希** —— 没有任何 task 的**产物**取决于外部传进来
  // 的这个值（server 的 build 由脚本自己 `cross-env` 设定；Vite / Vitest / VitePress 各自强制
  // 自己的值）。放进 `globalEnv` 的代价是**整轮缓存作废**。
  // 判据可重跑：`NODE_ENV=a pnpm exec turbo run build --dry=json` 与 `NODE_ENV=b …` 比 hash，
  // 应当一个都不变。
  "globalPassThroughEnv": [
    "CI",
    "NODE_ENV",
    // ⚠️ 这三个是 `eslint-plugin-turbo` 的 `no-undeclared-env-vars` 抓出来的真缺口（都在 `@walnut/scripts`）：
    //   · `npm_execpath` —— `lib/pnpm-launcher.ts` 靠它定位 pnpm 的真 exe。
    //     被严格模式剥掉 ⇒ 退化成「找不到 pnpm」，且报错信息只会说找不到命令。
    //   · `PATH` —— 同上那条查找路径的后备。
    //   · `PREPUSH_CONCURRENCY` —— `prepush.ts` 的并发旋钮（`pnpm prepush` 本身不经 turbo，
    //     但同一份代码也会在 `@walnut/scripts` 的 turbo 任务里被 import 与测试）。
    // 三者都「只需可见、不进哈希」：它们不改变任何产物，只决定「去哪找可执行文件 / 开几路」。
    "npm_execpath",
    "PATH",
    "PREPUSH_CONCURRENCY",
    // 发版工具链真正依赖的两个（同样由上面那条规则抓出，2026-09-23）：
    //   · `GITHUB_API_URL` —— `release/src/release/github.ts` 的 GitHub Enterprise 覆盖点；
    //   · `GH_TOKEN` —— `release/src/release/credentials.ts` 的 token 回退来源（gh CLI 的惯例名）。
    "GITHUB_API_URL",
    "GH_TOKEN",
    "GITHUB_TOKEN",
    "VERCEL_TOKEN",
    "TURBO_TOKEN",
    "TURBO_TEAM"
  ],
  "tasks": {
    // 根级文件的 lint。**没有对应的 workspace 包**（`//#` = 根任务），所以它是一个独立任务，
    // 不会跟着任何包的 `lint` 跑；用 `turbo run lint:root` 调它才会命中缓存。
    //
    // ⚠️ `inputs` 与根脚本里那三个 glob **逐字一致**（`eslint *.ts *.json *.yaml`）——
    // 这是本任务唯一需要记住的规矩，也是两个坑的分界线：
    //   · 写成 `$TURBO_ROOT$/**` 再逐条排除 ⇒ 那些「随运行变化」的目录（`.turbo`、各包的
    //     `dist`、`node_modules`）漏排一个，缓存就**永不命中**（每次 push 都真跑）；
    //   · 排过头（比如顺手排掉 `packages/**`）⇒ 根 eslint 配置 import 的东西不进缓存键，
    //     改完规则却回放旧结论 —— **门禁假绿**（参考仓实测踩过这个方向）。
    // 实测（2026-09-23）：这三个 glob 在根目录命中 9 个文件，`eslint` 实际检查的正是这 9 个。
    // 门禁 `walnut-check-turbo-cache` 的第 8 条不变量会把「脚本 glob」与「task inputs」对起来。
    "//#lint:root": {
      "outputs": [],
      "inputs": [
        "$TURBO_ROOT$/*.ts",
        "$TURBO_ROOT$/*.json",
        "$TURBO_ROOT$/*.yaml"
      ]
    },
    // 传递节点（**没有对应脚本**，只是个图节点）。存在的唯一理由：
    // `dependsOn: ["^build"]` 只能把「上游的 build 产物」串进哈希，而本仓的共享包
    // （contract / types / utils / client / http / ui）**根本不构建**（vitest/jest 之外的
    // `build` 只是一句 echo），下游真正读到的是它们的**源码**。
    // 2026-09-23 实测（改 `packages/platform-any/types/src/index.d.ts` 一行注释）：
    //   加 transit 之前 → 只有 14 个 task 失效，`@walnut/admin#types:check` **纹丝不动**
    //                     （它 `dependsOn: []`，而依赖包源码不在它的 inputs 里）⇒ 回放假绿
    //   加 transit 之后 → 上游源码进哈希，`types:check` 正确失效
    // `transit` 自己带 `^transit`，于是「上游的 inputs」沿依赖图逐级并进本节点的哈希。
    // 只挂给 `types:check`：`test`/`build` 走 `^build` 已经覆盖（那几个 echo 的 build
    // 任务 inputs 就是包内文件）；`lint` **刻意不挂** —— ESLint 不跨包跟随 import，
    // 依赖包源码变化不该让下游重 lint（挂了会让 lint 缓存命中率大跌）。
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": [],
      "cache": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vitepress/dist/**"],
      // ⚠️ `env-local/**` 必须显式写：Vite 的 `envDir` 就是它（apps/admin/build/constant.ts），
      // 但它**被 gitignore**，所以 `$TURBO_DEFAULT$` 看不见它 —— 也就不进哈希。
      // 后果：改一份解密后的 .env（或重跑 `pnpm setup-env` 换了值）→ 构建**不失效** →
      // 打出来的包内联的是旧 `VITE_*`。2026-09-23 实测：显式 glob **能**盖过 gitignore
      // （加上后 admin#build 的输入从 748 → 752，多出的正是 env-local 下那 4 个文件）。
      // 该 glob 是包内相对路径，只对真有 `env-local/` 的包生效。
      "inputs": [
        "$TURBO_DEFAULT$",
        "env-local/**",
        "!README.md",
        "!**/*.md",
        "!**/tsconfig.tsbuildinfo"
      ],
      "env": ["VITE_*", "MODE"],
      "cache": true
    },
    "build:stage": {
      "dependsOn": ["^build:stage"],
      // ⚠️ 两个 staging 产物目录都要在这儿：admin 的由 `VITE_BUILD_OUT_DIR` 决定、实际值是
      // `dist-staging`；server 的由 `infra/nest/stage.json` 的 `compilerOptions.outDir` 决定、
      // 实际值是 `dist-stage`（里面再套一层 `apps/api/src`，那是 Nest monorepo 的 root 决定的）。
      // 漏掉任何一个的后果都是**静默**的 —— 2026-09-23 实测见文件头 ②。
      "outputs": ["dist/**", "dist-staging/**", "dist-stage/**", ".vitepress/dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "env-local/**",
        "!README.md",
        "!**/*.md",
        "!**/tsconfig.tsbuildinfo"
      ],
      "env": ["VITE_*", "MODE"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "interruptible": true,
      "cache": false
    },
    "preview": {
      "dependsOn": ["^build"],
      "persistent": true,
      "interruptible": true,
      "cache": false
    },
    "lint": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/dist/**",
        "!**/*.md"
      ],
      "cache": true
    },
    "lint:fix": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/dist/**",
        "!**/*.md"
      ],
      "cache": false
    },
    "types:check": {
      // 挂 `transit` 而不是 `^build`：本仓共享包不构建，类型是从**源码**读的。
      // 详见 `transit` 任务上方的实测记录。
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ],
      // 正常 `vitest run`（不带 --coverage）不产出任何文件 —— 声明 `coverage/**` 会让每个
      // 有 test 脚本的包都刷一条 "no output files found for task"。要恢复覆盖率产物缓存，
      // 就在 run 脚本里加 --coverage，并把这里改回 ["coverage/**"]。
      "outputs": [],
      "cache": true
    },
    "clean": {
      "dependsOn": [],
      "cache": false
    },
    "clean:all": {
      "dependsOn": [],
      "cache": false
    }
  }
}
