{
  // ─────────────────────────────────────────────────────────────────────────────
  // 缓存边界（改哪个文件会让哪个 task 的缓存失效）：完整判据表见
  // apps/docs/src/zh-CN/content/monorepo/turbo-cache-boundary.md
  //
  // 判据的唯一真源是**跑出来的**，不是我们对配置的二次解读：
  //   pnpm exec turbo run <task> --dry=json → 比对各 task 的 hash；它同时给出每个 task 的
  //   `inputs`（文件 → 内容哈希）与 `globalCacheInputs`（全局哈希的构成）。
  // 机械门禁：`pnpm walnut lint:turbo-cache`（walnut-check-turbo-cache），push 前 / CI / 发版三处都跑。
  //
  // 三条最容易踩的：
  //   ① 共享包是**源码直消费**（`exports` 指 `./src/**`）⇒「依赖包源码变了」必须让下游的
  //      `types:check` 失效 —— 这就是下面 `transit` 任务存在的原因。
  //   ② 产物目录必须逐个进 `outputs`：漏一个的后果不是报错，而是**缓存命中时静默不产出**
  //      （turbo 照报 `FULL TURBO` + exit 0，而盘上一个文件都没有）。
  //   ③ 根 `turbo.json` 按**解析后的语义**进哈希、不按文本：加一条匹配不到任何文件的排除 glob
  //      不会让任何 task 失效，而真改 `inputs` / `outputs` 会。
  // ─────────────────────────────────────────────────────────────────────────────
  "$schema": "https://turbo.build/schema.json",
  // ── 本地缓存的自动回收（Turbo 2.10+）──────────────────────────────────────────
  // 上限到了随用随回收，不必再手工清 `.turbo/cache`。
  "cacheMaxAge": "14d",
  "cacheMaxSize": "5GB",
  // 并发上限。**Turbo 的默认值是 10** —— 本仓 12 核，而 `test` 任务下每个 vitest 进程默认
  // 又会按 CPU 数开 worker ⇒ 两级并发乘起来最坏能到 10×12 个进程。
  // 收到 4 是与 `@walnut/vitest-config` 的 `maxWorkers: '50%'` **配套**的（那一条同时钉住
  // 单任务的 worker 数）—— 两级必须一起收敛，只改一级等于没改。
  "concurrency": "4",
  "boundaries": {
    "tags": {
      "shared": {
        "dependencies": {
          "deny": ["app"]
        }
      },
      "backend": {
        "dependencies": {
          "deny": ["platform-web"]
        }
      },
      "platform-any": {
        "dependencies": {
          "deny": ["platform-web", "platform-node"]
        }
      },
      "platform-node": {
        "dependencies": {
          "deny": ["platform-web"]
        }
      },
      // 生成物包（`@walnut/api-types`，2026-11 批次 4 · D9 起在 `packages/generated/` 下）。
      // 它由 openapi-typescript 从 `apps/server/openapi.json` 机械产出、**零手写**：
      //   · 不许依赖 app —— 生成物反过来 import 应用代码，等于把生成链变成环；
      //   · 不许被后端依赖（backend tag）—— 后端要的类型真源是 DTO 本身，拿生成物当输入会让
      //     「DTO 改 → 重导 → 生成物变 → 后端类型变」形成自指的循环。
      // 反向断言（每个 key 必须有包声明它）由 `pnpm walnut lint:turbo-cache` 守。
      "generated": {
        "dependencies": {
          "deny": ["app", "backend"]
        }
      },
      // 前端（含 admin 与 platform-web 两个库）**不得消费 Node 平台包**。
      // 这条规则补的是一个此前**完全不存在**的方向：上面 4 条里没有任何一条约束它，
      // 实测（批次 2 的 R1 复核）给 apps/admin 加一条 @walnut/server 依赖时 boundaries
      // 一声不响 —— 前端可以合法地依赖后端包，直到运行时或打包时才炸。
      //
      // 为什么挂在已有的 `platform-web` 上、而不是新建 `frontend` 键：这条 tag 由
      // apps/admin 与 packages/platform-web/{client,http} 共同声明（api-types 于 2026-11
      // 批次 4 挪到 packages/generated/ 并改声明 generated），
      // 一条规则同时守住「前端 app」和「前端库」两侧；而 `frontend` 只有 apps/admin
      // 声明，是个只服务单个包的键（将来真出现第二个前端 app 再议）。
      // 反向断言见 `pnpm walnut lint:turbo-cache`：boundaries.tags 的每个 key 都必须有包声明它。
      "platform-web": {
        "dependencies": {
          "deny": ["platform-node"]
        }
      }
    }
  },
  // 全局哈希的构成（任何一条变了 → 全部 task 失效）：这些文件的内容 + `globalEnv` 的值 +
  // **内部依赖哈希**（根 `package.json` 依赖到的 workspace 包，其源码内容也算全局输入）。
  // 想缩小失效面就别往这里加；想扩大覆盖面优先考虑 `transit`，而不是继续堆全局条目。
  "globalDependencies": [
    "package.json",
    "tsconfig.json",
    "eslint.config.ts",
    "commitlint.config.ts",
    "knip.config.ts",
    "pnpm-workspace.yaml",
    "tooling/tsconfig/*.json",
    "tooling/vitest-config/*.ts"
  ],
  // `NODE_ENV` **刻意不放在 `globalEnv`**：它必须**可见**（Turbo 的严格模式会剥离未声明的
  // 变量，而它不在内置放行名单里），但**不该进哈希** —— 没有任何 task 的**产物**取决于外部传进来
  // 的这个值（server 的 build 由脚本自己 `cross-env` 设定；Vite / Vitest / VitePress 各自强制
  // 自己的值）。放进 `globalEnv` 的代价是**整轮缓存作废**。
  // 判据可重跑：`NODE_ENV=a pnpm exec turbo run build --dry=json` 与 `NODE_ENV=b …` 比 hash，
  // 应当一个都不变。
  "globalPassThroughEnv": [
    "WORKER_STANDALONE",
    "CI",
    "NODE_ENV",
    // 这三个是 `eslint-plugin-turbo` 的 `no-undeclared-env-vars` 抓出来的真缺口（都在 `@walnut/scripts`）：
    //   · `npm_execpath` —— `lib/pnpm-launcher.ts` 靠它定位 pnpm 的真 exe。
    //     被严格模式剥掉 ⇒ 退化成「找不到 pnpm」，且报错信息只会说找不到命令。
    //   · `PATH` —— 同上那条查找路径的后备。
    //   · `PREPUSH_CONCURRENCY` —— `prepush.ts` 的并发旋钮（`pnpm prepush` 本身不经 turbo，
    //     但同一份代码也会在 `@walnut/scripts` 的 turbo 任务里被 import 与测试）。
    // 三者都「只需可见、不进哈希」：它们不改变任何产物，只决定「去哪找可执行文件 / 开几路」。
    "npm_execpath",
    "PATH",
    "PREPUSH_CONCURRENCY",
    // `SMOKE_FAIL_API` —— `pnpm walnut smoke:dist` 的**负对照开关**（2026-10-08）：置 `1` 时静态服务把所有
    // `/api/**` 按后端真实错误信封应答（500 + `code: 50000`），用来确定性地复现
    // 「空库 ⇒ 签名握手失败 ⇒ 应用必须显示错误屏、而不是白屏」这条链路。
    // 同样「只需可见、不进哈希」：它不改变任何产物，只决定这次冒烟**期望**看到哪种结果。
    // （它由 `no-undeclared-env-vars` 抓出 —— 那条规则是对的：未声明的变量在严格模式下会被剥掉。）
    "SMOKE_FAIL_API",
    // 全链路 E2E 的 webServer 复用开关（`apps/e2e/playwright.config.ts`）：置 `1` 才复用
    // 3001 / 4173 上已在监听的进程（默认关闭，理由见该文件注释）。同样只需可见、不进哈希 ——
    // 它只决定这次跑用不用残留进程，不改变任何产物。
    "E2E_REUSE_SERVER",
    // 全链路 E2E 的测试库封板开关（`apps/e2e/scripts/{run,baseline}.ts`）：
    //   · `E2E_SKIP_BASELINE=1` —— 忽略基线快照、退回全量 prepare（排查基线本身的问题用）；
    //   · `E2E_REBUILD_BASELINE=1` —— 强制全量 prepare + 重新封板（与 `--rebuild-baseline` 等价）。
    // 两者只决定这一轮怎么准备库，不改变任何 task 产物 —— 只需可见、不进哈希。
    "E2E_SKIP_BASELINE",
    "E2E_REBUILD_BASELINE",
    // 全链路 E2E 的 Redis 设备键对账开关（`apps/e2e/scripts/run.ts` + `scripts/redis-gc.ts`，P2-2）：
    // 置 `0` 跳过「库准备之后、按 deviceId 清孤儿键」那一步（默认开）。它只决定这一轮清不清残留键，
    // 不改变任何 task 产物 —— 只需可见、不进哈希。
    "E2E_REDIS_GC",
    // 全链路 E2E 的 flaky 隔离名单开关（`apps/e2e/playwright.config.ts` + `scripts/quarantine.ts`，P2-1）：
    // 置 `1` 时忽略 `quarantine.json`（默认把名单条目从各 project 的 grepInvert 里排除）。
    // 它只决定这一轮跑不跑隔离用例，不改变任何 task 产物 —— 只需可见、不进哈希。
    "E2E_INCLUDE_QUARANTINE",
    // 基线 dump / restore 的执行层（`apps/e2e/scripts/pg-container.ts`，P1-1）：
    //   · `E2E_PG_CONTAINER` —— 数据栈容器名（默认 e2e-wsl-postgres；通用 compose 是 e2e-postgres；
    //     CI 上不设时按镜像 postgres:18-alpine 解析 service 容器）；
    //   · `E2E_PG_EXEC_MODE` —— 投递形态覆盖（auto / wsl / docker；Windows + Docker Desktop 用 docker）。
    // 两者只决定「怎么连容器」，不改变任何 task 产物 —— 只需可见、不进哈希。
    "E2E_PG_CONTAINER",
    "E2E_PG_EXEC_MODE",
    // 全链路 E2E 的 **stack profile** 选择（`apps/e2e/scripts/stack-profiles.ts`，P1-6 Phase A）：
    // `default`（不设）/ `smoke` / `risk` / `network`。它决定库名、后端 / socket / 静态代理端口、
    // 基线目录与 IP 段 —— 只影响「这一轮连哪套栈」，不改变 task 产物，因此只需可见、不进哈希。
    // **只接受 profile 名**：不开放端口 / 库名的单独覆盖（任意覆盖会让 assertE2eDatabase 失去意义）。
    "E2E_STACK_PROFILE",
    // 全链路 E2E 自愈用例的**负对照开关**（`apps/e2e/lib/ui.ts` 的 `waitForDeviceHealSettled`）：
    // 置 `1` 时跳过 CAP 求解、收到 40116 立刻带上下文抛错 —— 只用来验证「失败是快速可读的，
    // 而不是挂到 120s 超时」。只决定这一轮怎么等待，不改变任何 task 产物 —— 只需可见、不进哈希。
    // 生产用例不得设置（它会让本应通过的 U8/U9 必定失败）。
    "E2E_SKIP_CAP_SOLVE",
    // 发版工具链真正依赖的两个（同样由上面那条规则抓出，2026-09-23）：
    //   · `GITHUB_API_URL` —— `release/src/release/github.ts` 的 GitHub Enterprise 覆盖点；
    //   · `GH_TOKEN` —— `release/src/release/credentials.ts` 的 token 回退来源（gh CLI 的惯例名）。
    "GITHUB_API_URL",
    "GH_TOKEN",
    "GITHUB_TOKEN",
    // `db:seed --admin` 的口令回退来源（同样由 `no-undeclared-env-vars` 抓出）：命令行参数更好，
    // 但它会进 shell 历史 —— CI / 脚本里用环境变量更合适。只需可见、不进哈希（不影响任何产物）。
    "SEED_ADMIN_PASSWORD",
    // 集成测试的数据源开关（`TEST_DATA=real` → dev 库全量 dump/restore；缺省 seed 层）。
    // 只决定 globalSetup 走哪条腿，不影响任何 task 的产物 → 只需可见、不进哈希。
    "TEST_DATA",
    "VERCEL_TOKEN",
    "TURBO_TOKEN",
    "TURBO_TEAM"
  ],
  "tasks": {
    // 根级文件的 lint。**没有对应的 workspace 包**（`//#` = 根任务），所以它是一个独立任务，
    // 不会跟着任何包的 `lint` 跑；用 `turbo run lint:root` 调它才会命中缓存。
    //
    // `inputs` 与命令表里 `lint:root` 那三个 glob **逐字一致**（`eslint *.ts *.json *.yaml`）——
    // 这是本任务唯一需要记住的规矩，也是两个坑的分界线：
    //   · 写成 `$TURBO_ROOT$/**` 再逐条排除 ⇒ 那些「随运行变化」的目录（`.turbo`、各包的
    //     `dist`、`node_modules`）漏排一个，缓存就**永不命中**（每次 push 都真跑）；
    //   · 排过头（比如顺手排掉 `packages/**`）⇒ 根 eslint 配置 import 的东西不进缓存键，
    //     改完规则却回放旧结论 —— **门禁假绿**（参考仓实测踩过这个方向）。
    // 实测（2026-09-23）：这三个 glob 在根目录命中 9 个文件，`eslint` 实际检查的正是这 9 个。
    // 门禁 `walnut-check-turbo-cache` 的第 8 条不变量会把「命令表的 glob」与「task inputs」对起来。
    "//#lint:root": {
      "outputs": [],
      "inputs": [
        "$TURBO_ROOT$/*.ts",
        "$TURBO_ROOT$/*.json",
        "$TURBO_ROOT$/*.yaml"
      ]
    },
    // 传递节点（**没有对应脚本**，只是个图节点）。存在的唯一理由：
    // `dependsOn: ["^build"]` 只能把「上游的 build 产物」串进哈希，而本仓的共享包
    // （contract / types / utils / client / http / ui）**根本不构建**（vitest/jest 之外的
    // `build` 只是一句 echo），下游真正读到的是它们的**源码**。
    // 2026-09-23 实测（改 `packages/platform-any/types/src/index.d.ts` 一行注释）：
    //   加 transit 之前 → 只有 14 个 task 失效，`@walnut/admin#types:check` **纹丝不动**
    //                     （它 `dependsOn: []`，而依赖包源码不在它的 inputs 里）⇒ 回放假绿
    //   加 transit 之后 → 上游源码进哈希，`types:check` 正确失效
    // `transit` 自己带 `^transit`，于是「上游的 inputs」沿依赖图逐级并进本节点的哈希。
    // 只挂给 `types:check`：`test`/`build` 走 `^build` 已经覆盖（那几个 echo 的 build
    // 任务 inputs 就是包内文件）；`lint` **刻意不挂** —— ESLint 不跨包跟随 import，
    // 依赖包源码变化不该让下游重 lint（挂了会让 lint 缓存命中率大跌）。
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": [],
      "cache": true
    },
    "build": {
      // `clean:build` 的同包依赖：缓存命中时也先清产物目录（additive 恢复的补丁，见下方 clean:* 注释）。
      // 只有 admin 定义这个脚本；其余包缺脚本时 turbo 报 `<NONEXISTENT>` 并跳过（与 build:stage 的
      // clean:stage 同形态，不是错误）。
      "dependsOn": ["^build", "clean:build"],
      "outputs": ["dist/**", ".vitepress/dist/**"],
      // `env-local/**` 必须显式写：Vite 的 `envDir` 就是它（apps/admin/build/constant.ts），
      // 但它**被 gitignore**，所以 `$TURBO_DEFAULT$` 看不见它 —— 也就不进哈希。
      // 后果：改一份解密后的 .env（或重跑 `pnpm setup-env` 换了值）→ 构建**不失效** →
      // 打出来的包内联的是旧 `VITE_*`。2026-09-23 实测：显式 glob **能**盖过 gitignore
      // （加上后 admin#build 的输入从 748 → 752，多出的正是 env-local 下那 4 个文件）。
      // 该 glob 是包内相对路径，只对真有 `env-local/` 的包生效。
      "inputs": [
        "$TURBO_DEFAULT$",
        "env-local/**",
        "!README.md",
        "!**/*.md",
        "!**/tsconfig.tsbuildinfo"
      ],
      "env": ["VITE_*", "MODE"],
      "cache": true
    },
    // 产物目录的「清空」必须发生在缓存边界**之外**：turbo 的缓存恢复是 additive 的 ——
    // 只把缓存里的文件写回去，**不删**目录里多出来的旧文件；而 Vite 的 emptyOutDir 只在真跑
    // 构建时生效。于是「改样式 → 构建 → 还原 → 再构建（缓存命中）」会在产物目录里留下
    // 两套 hash chunk（P2-C 的「旧分块累积」就是这个）。
    //
    // 两条 clean 都设 cache:false（每次都跑）、并作为**同包构建任务的依赖**先执行：缓存命中时它
    // 清目录、turbo 再恢复 = 精确产物；未命中时它先清、Vite 再空目录构建。
    //   · clean:stage —— build:stage 的依赖，清 `dist-staging`（2026-11-25，见 turbo-cache-boundary §4.8）；
    //   · clean:build —— build 的依赖，清 prod 的 `dist`（2026-11-26 收尾）。
    // **范围只收窄到 admin**：hash chunk 是 **Vite** 独有的风险；其余包的 build 产物是固定名文件
    // （`dist/*.cjs`、`dist-stage/**` 的编译结果），增量恢复不会多出一套，反而白付一次 rimraf。
    // 判据是「产物里有没有随内容变化的文件名」，不是「这个包也构建」。clean:* 只有真需要清产物的
    // 包才定义（目前只有 admin）。
    "clean:stage": {
      "dependsOn": [],
      "cache": false
    },
    "clean:build": {
      "dependsOn": [],
      "cache": false
    },
    "build:stage": {
      "dependsOn": ["^build:stage", "clean:stage"],
      // 两个 staging 产物目录都要在这儿：admin 的由 `VITE_BUILD_OUT_DIR` 决定、实际值是
      // `dist-staging`；server 的由 `infra/nest/stage.json` 的 `compilerOptions.outDir` 决定、
      // 实际值是 `dist-stage`（里面再套一层 `apps/api/src`，那是 Nest monorepo 的 root 决定的）。
      // 漏掉任何一个的后果都是**静默**的 —— 2026-09-23 实测见文件头 ②。
      "outputs": ["dist/**", "dist-staging/**", "dist-stage/**", ".vitepress/dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "env-local/**",
        "!README.md",
        "!**/*.md",
        "!**/tsconfig.tsbuildinfo"
      ],
      "env": ["VITE_*", "MODE"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "interruptible": true,
      "cache": false
    },
    "preview": {
      "dependsOn": ["^build"],
      "persistent": true,
      "interruptible": true,
      "cache": false
    },
    "lint": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/dist/**",
        "!**/*.md"
      ],
      "cache": true
    },
    "lint:fix": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/dist/**",
        "!**/*.md"
      ],
      "cache": false
    },
    "types:check": {
      // 挂 `transit` 而不是 `^build`：本仓共享包不构建，类型是从**源码**读的。
      // 详见 `transit` 任务上方的实测记录。
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ],
      // 正常 `vitest run`（不带 --coverage）不产出任何文件 —— 声明 `coverage/**` 会让每个
      // 有 test 脚本的包都刷一条 "no output files found for task"。要恢复覆盖率产物缓存，
      // 就在 run 脚本里加 --coverage，并把这里改回 ["coverage/**"]。
      "outputs": [],
      "cache": true
    },
    "clean": {
      "dependsOn": [],
      "cache": false
    },
