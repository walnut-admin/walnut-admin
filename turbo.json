{
  "$schema": "https://turbo.build/schema.json",
  "boundaries": {
    "tags": {
      "shared": {
        "dependencies": {
          "deny": ["app"]
        }
      },
      "backend": {
        "dependencies": {
          "deny": ["platform-web"]
        }
      },
      "platform-any": {
        "dependencies": {
          "deny": ["platform-web", "platform-node"]
        }
      },
      "platform-node": {
        "dependencies": {
          "deny": ["platform-web"]
        }
      }
    }
  },
  "globalDependencies": [
    "package.json",
    "tsconfig.json",
    "eslint.config.ts",
    "commitlint.config.ts",
    "knip.config.ts",
    "pnpm-workspace.yaml",
    "packages/tooling/tsconfig/*.json"
  ],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "CI",
    "GITHUB_TOKEN",
    "VERCEL_TOKEN",
    "TURBO_TOKEN",
    "TURBO_TEAM"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vitepress/dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!**/*.md",
        "!**/tsconfig.tsbuildinfo"
      ],
      "env": ["VITE_*", "MODE"],
      "cache": true
    },
    "build:stage": {
      "dependsOn": ["^build:stage"],
      "outputs": ["dist/**", ".vitepress/dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!**/*.md",
        "!**/tsconfig.tsbuildinfo"
      ],
      "env": ["VITE_*", "MODE"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "interruptible": true,
      "cache": false
    },
    "preview": {
      "dependsOn": ["^build"],
      "persistent": true,
      "interruptible": true,
      "cache": false
    },
    "lint": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/dist/**",
        "!**/*.md"
      ],
      "cache": true
    },
    "lint:fix": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/dist/**",
        "!**/*.md"
      ],
      "cache": false
    },
    "types:check": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ],
      // 正常 `vitest run`（不带 --coverage）不产出任何文件 —— 声明 `coverage/**` 会让每个
      // 有 test 脚本的包都刷一条 "no output files found for task"。要恢复覆盖率产物缓存，
      // 就在 run 脚本里加 --coverage，并把这里改回 ["coverage/**"]。
      "outputs": [],
      "cache": true
    },
    "clean": {
      "dependsOn": [],
      "cache": false
    },
    "clean:all": {
      "dependsOn": [],
      "cache": false
    }
  }
}
