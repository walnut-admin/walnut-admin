APP_API_PREFIX={{your api prefix}} # global api prefix, e.g. "w"
APP_API_VERSION=1 # global api version
APP_PORT=3000 # app listen port
APP_THROTTLE_TTL=60 # app rate limit, the time to live in seconds for the request tracker
APP_THROTTLE_LIMIT=120 # app rate limit, how many times an endpoint can be hit before returning a 429
APP_CACHE_TTL=0 # app cache, 0 for no limit until manually cleared
APP_CACHE_MAX=100 # app cache, max numbers of the cached item
APP_I18N_FALLBACK=en_US # app i18n, fallback language when no language support
APP_COOKIE_SECRET={{your cookie secret}}
APP_SESSION_SECRET={{your session secret}}

# app name, used for opaque identifier server, so do not change this easily cause it would make all password invalid
APP_NAME=walnut-admin
# mongoDB TLS/SSL purpose
SERVER_NAME=WalnutAdminServer

# redis config, host post and password, no username support yet
APP_REDIS_HOST=127.0.0.1
APP_REDIS_PORT=6379
APP_REDIS_PASS={{your redis password}}

# mongodb replica set config
DATABASE_PRIMARY={{your mongodb primary host:port}}
DATABASE_SECONDARY={{your mongodb secondary host:port}}
DATABASE_ARBITER={{your mongodb arbiter host:port}}
DATABASE_REPLICASET={{your mongodb replica set name}}
DATABASE_NAME=walnut-admin-nest # main database name
DATABASE_SOURCE=admin # mongo auth database source, normally `admin`.
# username and password to authenticate the database
DATABASE_USER={{your authenticated username}}
DATABASE_PASS={{your authenticated password}}

# jwt relatives
JWT_ACCESS_TOKEN_SECRET={{your access token secret}}
JWT_ACCESS_TOKEN_EXPIRE=300 # normally should be way less than the refresh token expire
JWT_REFRESH_TOKEN_SECRET={{your refresh token secret}}
JWT_REFRESH_TOKEN_EXPIRE=36000

# auth opaque secret, do not change easily
AUTH_OPAQUE_SECRET={{your auth opaque secret}}

# mfa encryption key, used for encrypting mfa code, do not change easily
MFA_ENCRYPTION_KEY={{your mfa encryption key}}
# refresh token encryption key, used for encrypting refresh token, do not change easily
RT_ENCRYPTION_KEY={{your refresh token encryption key}}
# device id encryption key, used for encrypting device id, do not change easily
DEVICE_ID_ENCRYPTION_KEY={{your device id encryption key}}
# user identity encryption key, used for encrypting user identity, do not change easily
USER_ID_ENCRYPTION_KEY={{your user id encryption key}}
# user identity hash salt, used for hashing user identity, do not change easily
USER_ID_HASH_SALT={{your user id hash salt}}

# socket config
SOCKET_SERVER_PORT=5173
SOCKET_SERVER_PATH=/walnut-path/
SOCKET_SERVER_ORIGIN={{your socket origin}}

# baidu ak to get location through ip
VENDOR_KEYS_BAIDU={{your baidu ak}}

# email config
EMAIL_HOST={{your email host}}
EMAIL_PORT={{your email port}}
EMAIL_AUTH_USER={{your email auth user}}
EMAIL_AUTH_PASS={{your email auth pass}}
EMAIL_FROM_ADDRESS={{your email from address}}
EMAIL_FROM_NAME={{your email from name}}

# oauth relatives
# callback must be a full url
AUTH_GITHUB_CLIENTID={{your github client id}}
AUTH_GITHUB_CLIENTSECRET={{your github client secret}}
AUTH_GITHUB_CALLBACK={{your github oauth callback url}}

AUTH_GITEE_CLIENTID={{your gitee client id}}
AUTH_GITEE_CLIENTSECRET={{your gitee client secret}}
AUTH_GITEE_CALLBACK={{your gitee oauth callback url}}

AUTH_GOOGLE_CLIENTID={{your google client id}}

# webauthn config
AUTH_WEBAUTHN_RPID={{your webauthn rp id}}
AUTH_WEBAUTHN_ORIGIN={{your webauthn origin}}

# ali oss config
VENDOR_KEYS_ALI_OSS_REGION={{your ali oss region}}
VENDOR_KEYS_ALI_OSS_BUCKET={{your ali oss bucket}}
VENDOR_KEYS_ALI_OSS_ID={{your ali oss id}}
VENDOR_KEYS_ALI_OSS_SECRET={{your ali oss secret}}
VENDOR_KEYS_ALI_OSS_ENDPOINT={{your ali oss endpoint}}
VENDOR_KEYS_ALI_OSS_ROLE_ARN={{your ali oss role arn}}
VENDOR_KEYS_ALI_OSS_ROLE_SESSION_NAME={{your ali oss role session name}}

# tencent sms config
VENDOR_KEYS_TX_SMS_REGION={{your tencent sms region}}
VENDOR_KEYS_TX_SMS_ID={{your tencent sms id}}
VENDOR_KEYS_TX_SMS_SECRET={{your tencent sms secret}}
VENDOR_KEYS_TX_SMS_ENDPOINT={{your tencent sms endpoint}}
VENDOR_KEYS_TX_SMS_SDK_APP_ID={{your tencent sms sdk app id}}
VENDOR_KEYS_TX_SMS_SIGN_NAME={{your tencent sms sign name}}
VENDOR_KEYS_TX_SMS_TEMPLATE_ID={{your tencent sms template id}}
