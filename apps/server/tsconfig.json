{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "target": "es2022",
    "sourceMap": false,
    "outDir": "./dist",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "composite": false,
    "types": ["node", "jest"],
    "paths": {
      "@/*": [
        "./apps/api/src/*"
      ],
      "@walnut/config": [
        "./libs/config/src"
      ],
      "@walnut/config/*": [
        "./libs/config/src/*"
      ],
      "@walnut/const": [
        "./libs/const/src"
      ],
      "@walnut/const/*": [
        "./libs/const/src/*"
      ],
      "@walnut/db": [
        "./libs/db/src"
      ],
      "@walnut/db/*": [
        "./libs/db/src/*"
      ],
      "@walnut/utils": [
        "./libs/utils/src"
      ],
      "@walnut/utils/*": [
        "./libs/utils/src/*"
      ],
      "@walnut/types": [
        "./libs/types/src"
      ],
      "@walnut/types/*": [
        "./libs/types/src/*"
      ],
      "@walnut/decorators": [
        "./libs/decorators/src"
      ],
      "@walnut/decorators/*": [
        "./libs/decorators/src/*"
      ],
      "@walnut/pipes": [
        "./libs/pipes/src"
      ],
      "@walnut/pipes/*": [
        "./libs/pipes/src/*"
      ],
      "@walnut/exceptions": [
        "./libs/exceptions/src"
      ],
      "@walnut/exceptions/*": [
        "./libs/exceptions/src/*"
      ],
      "@walnut/context": [
        "./libs/context/src"
      ],
      "@walnut/context/*": [
        "./libs/context/src/*"
      ]
    }
  }
}
