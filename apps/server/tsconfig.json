{
  "$comment": "This tsconfig is intentionally self-contained and does NOT extend any preset from @walnut/tsconfig. See ADR 0012 for rationale: CJS/ESM module system divergence makes shared compilerOptions unsafe.",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "target": "es2022",
    "rootDir": "../../",
    "sourceMap": false,
    "outDir": "./dist",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "composite": false,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./apps/api/src/*"
      ],
      "@walnut-server/config": [
        "./libs/config/src"
      ],
      "@walnut-server/config/*": [
        "./libs/config/src/*"
      ],
      "@walnut-server/const": [
        "./libs/const/src"
      ],
      "@walnut-server/const/*": [
        "./libs/const/src/*"
      ],
      "@walnut-server/db": [
        "./libs/db/src"
      ],
      "@walnut-server/db/*": [
        "./libs/db/src/*"
      ],
      "@walnut-server/utils": [
        "./libs/utils/src"
      ],
      "@walnut-server/utils/*": [
        "./libs/utils/src/*"
      ],
      "@walnut-server/types": [
        "./libs/types/src"
      ],
      "@walnut-server/types/*": [
        "./libs/types/src/*"
      ],
      "@walnut-server/decorators": [
        "./libs/decorators/src"
      ],
      "@walnut-server/decorators/*": [
        "./libs/decorators/src/*"
      ],
      "@walnut-server/pipes": [
        "./libs/pipes/src"
      ],
      "@walnut-server/pipes/*": [
        "./libs/pipes/src/*"
      ],
      "@walnut-server/exceptions": [
        "./libs/exceptions/src"
      ],
      "@walnut-server/exceptions/*": [
        "./libs/exceptions/src/*"
      ],
      "@walnut-server/context": [
        "./libs/context/src"
      ],
      "@walnut-server/context/*": [
        "./libs/context/src/*"
      ],
      "@walnut-server/als": [
        "./libs/als/src"
      ],
      "@walnut-server/als/*": [
        "./libs/als/src/*"
      ],
      "@walnut-server/blpath": [
        "./libs/blpath/src"
      ],
      "@walnut-server/blpath/*": [
        "./libs/blpath/src/*"
      ],
      "@walnut-server/cookie": [
        "./libs/cookie/src"
      ],
      "@walnut-server/cookie/*": [
        "./libs/cookie/src/*"
      ],
      "@walnut-server/crypto": [
        "./libs/crypto/src"
      ],
      "@walnut-server/crypto/*": [
        "./libs/crypto/src/*"
      ],
      "@walnut-server/delay": [
        "./libs/delay/src"
      ],
      "@walnut-server/delay/*": [
        "./libs/delay/src/*"
      ],
      "@walnut-server/lock": [
        "./libs/lock/src"
      ],
      "@walnut-server/lock/*": [
        "./libs/lock/src/*"
      ],
      "@walnut-server/queue": [
        "./libs/queue/src"
      ],
      "@walnut-server/queue/*": [
        "./libs/queue/src/*"
      ],
      "@walnut-server/sse": [
        "./libs/sse/src"
      ],
      "@walnut-server/sse/*": [
        "./libs/sse/src/*"
      ]
    }
  }
}
