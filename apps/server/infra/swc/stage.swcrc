{
  "$schema": "https://json.schemastore.org/swcrc",
  "sourceMaps": true,
  "inlineSourcesContent": false,
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "target": "es2022",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/api/src/*"],
      "@walnut-server/config": ["./libs/config/src"],
      "@walnut-server/config/*": ["./libs/config/src/*"],
      "@walnut-server/const": ["./libs/const/src"],
      "@walnut-server/const/*": ["./libs/const/src/*"],
      "@walnut-server/db": ["./libs/db/src"],
      "@walnut-server/db/*": ["./libs/db/src/*"],
      "@walnut-server/utils": ["./libs/utils/src"],
      "@walnut-server/utils/*": ["./libs/utils/src/*"],
      "@walnut-server/types": ["./libs/types/src"],
      "@walnut-server/types/*": ["./libs/types/src/*"],
      "@walnut-server/decorators": ["./libs/decorators/src"],
      "@walnut-server/decorators/*": ["./libs/decorators/src/*"],
      "@walnut-server/pipes": ["./libs/pipes/src"],
      "@walnut-server/pipes/*": ["./libs/pipes/src/*"],
      "@walnut-server/exceptions": ["./libs/exceptions/src"],
      "@walnut-server/exceptions/*": ["./libs/exceptions/src/*"],
      "@walnut-server/context": ["./libs/context/src"],
      "@walnut-server/context/*": ["./libs/context/src/*"],
      "@walnut-server/als": ["./libs/als/src"],
      "@walnut-server/als/*": ["./libs/als/src/*"],
      "@walnut-server/blpath": ["./libs/blpath/src"],
      "@walnut-server/blpath/*": ["./libs/blpath/src/*"],
      "@walnut-server/cookie": ["./libs/cookie/src"],
      "@walnut-server/cookie/*": ["./libs/cookie/src/*"],
      "@walnut-server/crypto": ["./libs/crypto/src"],
      "@walnut-server/crypto/*": ["./libs/crypto/src/*"],
      "@walnut-server/delay": ["./libs/delay/src"],
      "@walnut-server/delay/*": ["./libs/delay/src/*"],
      "@walnut-server/lock": ["./libs/lock/src"],
      "@walnut-server/lock/*": ["./libs/lock/src/*"],
      "@walnut-server/queue": ["./libs/queue/src"],
      "@walnut-server/queue/*": ["./libs/queue/src/*"],
      "@walnut-server/sse": ["./libs/sse/src"],
      "@walnut-server/sse/*": ["./libs/sse/src/*"],
      "@walnut-server/cache": ["./libs/cache/src"],
      "@walnut-server/cache/*": ["./libs/cache/src/*"],
      "@walnut-server/throttle": ["./libs/throttle/src"],
      "@walnut-server/throttle/*": ["./libs/throttle/src/*"]
    },
    "keepClassNames": true
  },
  "module": {
    "type": "commonjs"
  },
  "minify": false
}
