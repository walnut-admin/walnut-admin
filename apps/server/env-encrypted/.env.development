# socket.io Admin UI 凭据（生产必配；不配则 admin UI 不挂载 —— fail-closed）。
# PASSWORD 必须是 bcrypt hash：先定强口令（>= 8 位），再以 bcryptjs.hash(强口令, 10) 生成后填入（不接受明文）
# SOCKET_ADMIN_UI_USER=
# SOCKET_ADMIN_UI_PASSWORD=

# 反向代理可信跳数（F-11）：默认 1 = docker 单层 nginx；0 = 无代理直连；>1 按实际层数。
# 只信任 nginx 覆写后的 XFF（见 deploy/nginx/conf.d/api.conf），直连暴露会变成可伪造输入。
# APP_TRUST_PROXY_HOPS=1

# CORS 允许源覆盖（F-43）：逗号分隔，**覆盖**内置 dev 白名单 / prod 单源。
# 不要写 *（全站 cookie + credentials:true，通配源会被浏览器拒绝）。
# APP_CORS_ALLOW_ORIGINS=

