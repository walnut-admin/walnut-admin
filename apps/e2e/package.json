{
  "name": "@walnut/e2e",
  "type": "module",
  "version": "0.1.24",
  "private": true,
  "description": "全链路 E2E（Playwright）：独立 PG / Redis 栈 + dist-stage 后端 + dist-staging 前端，覆盖设备 ID 生命周期；跑之前要 setup-env、build:stage、playwright install 并起数据栈（见 README.md）",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "e2e": "node scripts/run.ts",
    "e2e:smoke": "node scripts/run.ts --project=smoke",
    "e2e:risk": "node scripts/run.ts --project=risk",
    "e2e:network": "node scripts/run.ts --project=network",
    "e2e:affected": "node scripts/affected.ts",
    "e2e:doctor": "node scripts/preflight.ts --doctor",
    "e2e:stack": "node scripts/stack.ts",
    "e2e:clean": "node scripts/clean.ts",
    "e2e:report": "playwright show-report",
    "lint": "eslint . --concurrency=4",
    "types:check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@serenity-kit/opaque": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@walnut/api-types": "workspace:*",
    "@walnut/contract": "workspace:*",
    "@walnut/eslint-config": "workspace:*",
    "@walnut/tsconfig": "workspace:*",
    "@walnut/utils": "workspace:*",
    "@walnut/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "otplib": "catalog:",
    "pg": "catalog:",
    "redis": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
