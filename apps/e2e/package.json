{
  "name": "@walnut/e2e",
  "type": "module",
  "version": "0.1.24",
  "private": true,
  "description": "Full-chain E2E harness (Playwright): dedicated PG/Redis stack + dist-stage backend + dist-staging admin + device-id lifecycle specs",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "e2e": "node scripts/run.ts",
    "e2e:smoke": "node scripts/run.ts --project=smoke",
    "e2e:risk": "node scripts/run.ts --project=risk",
    "e2e:report": "playwright show-report",
    "lint": "eslint . --concurrency=4",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@serenity-kit/opaque": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@walnut/contract": "workspace:*",
    "@walnut/eslint-config": "workspace:*",
    "@walnut/tsconfig": "workspace:*",
    "@walnut/utils": "workspace:*",
    "eslint": "catalog:",
    "otplib": "catalog:",
    "pg": "catalog:",
    "redis": "catalog:",
    "typescript": "catalog:"
  }
}
