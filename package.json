{
  "name": "walnut-admin",
  "version": "0.0.1",
  "private": true,
  "description": "Walnut Admin Monorepo",
  "license": "MIT",
  "author": {
    "name": "Zhaocl1997",
    "email": "zhaocl97@foxmail.com",
    "url": "https://github.com/Zhaocl1997"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/walnut-admin/walnut-admin.git"
  },
  "type": "module",
  "scripts": {
    "walnut": "node tooling/scripts/bin/run.ts",
    "dev": "turbo dev --filter=@walnut/admin --filter=@walnut/server",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "lint:root": "eslint *.ts *.json *.yaml --concurrency=4",
    "types:check": "turbo types:check",
    "test": "turbo test",
    "check": "walnut-check",
    "prepush": "walnut-prepush",
    "setup-env": "walnut-setup-env decrypt",
    "release": "walnut-release"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@types/node": "catalog:",
    "@walnut/commitlint-config": "workspace:*",
    "@walnut/eslint-config": "workspace:*",
    "@walnut/release": "workspace:*",
    "@walnut/scripts": "workspace:*",
    "@walnut/tsconfig": "workspace:*",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "lint-staged": "catalog:",
    "node-modules-inspector": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "syncpack": "catalog:",
    "taze": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js}": [
      "oxlint --fix",
      "eslint --fix --concurrency=4",
      "oxfmt --write"
    ],
    "*.{json,yml,yaml}": [
      "eslint --fix --concurrency=4",
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.5.1"
}
