{
  // 格式的唯一真源（Rust / Oxc）。ESLint 已退出格式职责：三个预设置 `stylistic: false`
  // 并以 `eslint-config-prettier` 兜底。改这里的取值 = 改全仓格式，别按偏好改，按「与现有
  // ESLint 侧实测对齐」改（下面三条的 `--print-config` 证据在
  // plans/rust-toolchain-migration-execution.md §6.2）。
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  // oxfmt 默认 100（Prettier 是 80）。首轮一次性大 diff 已拍板接受。
  "printWidth": 100,
  // 对齐 antfu 的 `style/comma-dangle=always-multiline`；不同会与 ESLint 打架。
  "trailingComma": "all",
  // ── 排序的唯一真源（2026-11-28 决策）──────────────────────────────────────
  // **归 oxfmt**：语句级 import 排序（`sortImports`）、`package.json` 的根键序与 `dependencies`
  // 的 asc（`sortPackageJson`）。ESLint 侧对应关掉 `perfectionist/sort-imports`（base / vue / nest
  // 三预设，`sort-ownership.ts`）与 `jsonc/sort-keys` 的**根键序**那一条。
  // **仍归 ESLint**（oxfmt 的能力边界）：具名 specifier / export 语句三条规则
  // （sort-named-imports / sort-named-exports / sort-exports），以及 package.json 的
  // `exports` 条件序（types → import → require → default）与 `pnpm.overrides` 的 asc
  // （oxfmt 不排 `exports` 子键，也不认 overrides 的字符串键序）。
  // 回滚这两个开关必须成对：只改这里会让 ESLint 把顺序改回去（反之亦然）。
  "sortPackageJson": true,
  // groups 逐组复刻 @antfu/eslint-config 8.2.0 的 perfectionist 配置（2026-11-28
  // `--print-config` 实测）；三处差异都是 oxfmt 的能力边界：
  //   · `ts-equals-import` 没有对应 selector ⇒ 落 `unknown`（与 perfectionist 的末组同位）；
  //   · perfectionist 的 `newlinesBetween: "ignore"` 在 oxfmt 只有布尔值 ⇒ false（不增删空行）；
  //   · oxfmt 不读 tsconfig 的 `paths`，`@walnut/*` / `@walnut-server/*` 一律归 external 组
  //     （perfectionist 时代按 internal）。要一致可加 `internalPattern`，但那会引入一次性重排，
  //     未做（2026-11-28 探针：全仓 2 文件 +3/−3）。
  "sortImports": {
    // 逐组照抄 antfu 的 perfectionist 配置（组名同义）；唯一替换是 `side-effect` → 预定义组
    // `side_effect`（oxfmt 用下划线）。首组必须是 `type-import` 这个 catch-all —— 写成 `type`
    // selector 会把 type-internal / type-sibling 一起吞掉，实测会让 200+ 文件重排。
    "groups": [
      "type-import",
      ["type-parent", "type-sibling", "type-index", "type-internal"],
      "value-builtin",
      "value-external",
      "value-internal",
      ["value-parent", "value-sibling", "value-index"],
      "side_effect",
      "unknown"
    ],
    "newlinesBetween": false,
    // 空行即分区：没有它，组内跨空行重排会吃掉 398 个文件的空行（2026-11-28 探针，
    // 数据在 plans/rust-toolchain-migration-execution.md §5）。开了它 = 2 文件 +3/−3。
    "partitionByNewline": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/dist-staging/**",
    "**/dist-stage/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/node_modules/**",
    "**/env-local/**",
    "pnpm-lock.yaml",
    // 生成物：openapi.json 由 openapi:export 重写、schema.d.ts 由它生成，格式化会与 git diff 门禁打架。
    // 只忽略**那一个文件**：`packages/generated/api-types` 的 package.json / tsconfig / eslint 配置
    // 与手写的 `src/index.ts` 照常受格式检查（2026-11-28 收窄，原先是整棵 `packages/generated/**`）。
    "apps/server/openapi.json",
    "packages/generated/api-types/src/schema.d.ts",
    "apps/admin/types/generated/**",
    // `pnpm version -r` 自己写这本书（double-quoted key 是它的固定输出）；格式化它会让
    // 每次发版后 format:check 变红 —— 与 openapi.json 同一类「机器写的文件」。
    ".changeset/ledger.yaml",
    // `apps/admin/build/generate` 在每次 types:check / build 时重写它（内容由 zod schema 推导）。
    // 格式化它同样会让 format:check 在构建后变红；生成器的输出就是这份文件的唯一真源。
    ".vscode/settings-dev.schema.json",
    // 首轮不碰 markdown：VitePress 的自定义块（tabs / mermaid / 容器）在格式化面前风险高，
    // 且冻结区文档被构建直接编译 ⇒ 直接忽略，md 另开一轮单独验证。
    "**/*.md",
    // `.hbs` 走 oxfmt 的 Glimmer 模板语言路径，会把 `<!DOCTYPE html>` 当冗余行删除（页面进
    // quirks mode）——模板语言一律不进格式化面，模板的唯一真源是手写内容。
    "**/*.hbs",
    // 第三方 / 静态运行时资产：原样分发，改一行都会在下次升级时被覆盖
    // （ESLint 侧的 admin 与 nest 预设同样忽略它们，理由见 apps/admin/eslint.config.ts 顶部）。
    "apps/admin/public/vendor/**",
    "apps/server/apps/api/src/public/**"
  ]
}
