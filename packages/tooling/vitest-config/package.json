{
  "name": "@walnut/vitest-config",
  "type": "module",
  "version": "0.0.1",
  "description": "共享 Vitest 预设：只收敛「用例发现规则 / 运行环境 / 覆盖率采集范围」三件会漂移的事，plugins 与 root 等交给各包显式传入。",
  "license": "MIT",
  "exports": {
    ".": "./index.ts"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@walnut/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "walnut": {
    "platform": "any",
    "type": "tooling",
    "runtime": "none"
  }
}
