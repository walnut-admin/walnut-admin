{
  "name": "@walnut/tooling",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "仓库级脚本的家：发版编排（release/）、仓库门禁（ci/）、env 加解密（env/）、通用纯逻辑（lib/）。不对外导出——由根 package.json 的脚本经 bin 调用。",
  "license": "MIT",
  "bin": {
    "walnut-release": "./bin/release.mjs",
    "walnut-lint-workflows": "./bin/lint-workflows.mjs",
    "walnut-setup-env": "./bin/setup-env.mjs",
    "walnut-check-git-hooks": "./bin/check-git-hooks.mjs"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "git-cliff": "catalog:",
    "tsx": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "walnut": {
    "platform": "any",
    "type": "tooling",
    "runtime": "none"
  }
}
