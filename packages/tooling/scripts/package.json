{
  "name": "@walnut/scripts",
  "type": "module",
  "version": "0.1.21",
  "private": true,
  "description": "仓库级脚本的通用层：纯逻辑工具（src/lib）、仓库门禁（src/ci）、env 加解密（src/env）。不对外导出成品功能，只导出被其它工具包复用的模块与 bin（清单见下方 bin 字段，别在描述里抄数量）。",
  "license": "MIT",
  "exports": {
    "./lib/*": "./src/lib/*.ts"
  },
  "bin": {
    "walnut-check-adr": "./bin/check-adr.ts",
    "walnut-check-catalog-lockstep": "./bin/check-catalog-lockstep.ts",
    "walnut-check-dist-secrets": "./bin/check-dist-secrets.ts",
    "walnut-check-doc-budgets": "./bin/check-doc-budgets.ts",
    "walnut-check-doc-refs": "./bin/check-doc-refs.ts",
    "walnut-check-doc-ts": "./bin/check-doc-ts.ts",
    "walnut-check-dts": "./bin/check-dts.ts",
    "walnut-check-git-hooks": "./bin/check-git-hooks.ts",
    "walnut-check-nginx-headers": "./bin/check-nginx-headers.ts",
    "walnut-check-package-exports": "./bin/check-package-exports.ts",
    "walnut-check-pre-hooks": "./bin/check-pre-hooks.ts",
    "walnut-check-seed": "./bin/check-seed.ts",
    "walnut-check-source-secrets": "./bin/check-source-secrets.ts",
    "walnut-check-turbo-cache": "./bin/check-turbo-cache.ts",
    "walnut-check-workflow-shell": "./bin/check-workflow-shell.ts",
    "walnut-db-export": "./bin/db-export.ts",
    "walnut-db-seed": "./bin/db-seed.ts",
    "walnut-lint-emoji": "./bin/check-emoji.ts",
    "walnut-lint-workflows": "./bin/lint-workflows.ts",
    "walnut-pack-seed": "./bin/pack-seed.ts",
    "walnut-prepush": "./bin/prepush.ts",
    "walnut-setup-env": "./bin/setup-env.ts",
    "walnut-smoke-dist": "./bin/smoke-dist.ts"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "lint": "eslint . --concurrency=4",
    "lint:fix": "eslint . --fix --concurrency=4",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@serenity-kit/opaque": "catalog:",
    "mongodb": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@walnut/tsconfig": "workspace:*",
    "@walnut/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "walnut": {
    "platform": "any",
    "type": "tooling",
    "runtime": "none"
  }
}
