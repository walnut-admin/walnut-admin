{
  "name": "@walnut/eslint-config",
  "type": "module",
  "version": "0.0.1",
  "description": "共享 ESLint 预设（flat config，基于 @antfu/eslint-config）：base（平台无关）/ vue（浏览器+Vue）/ nest（NestJS 后端，带本地装饰器排序规则）。",
  "license": "MIT",
  "exports": {
    "./base": "./base.ts",
    "./vue": "./vue.ts",
    "./nest": "./nest.ts"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "catalog:"
  },
  "dependencies": {
    "@antfu/eslint-config": "catalog:",
    "eslint-plugin-turbo": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@walnut/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "walnut": {
    "platform": "any",
    "type": "tooling",
    "runtime": "none"
  }
}
