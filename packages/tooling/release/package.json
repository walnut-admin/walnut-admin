{
  "name": "@walnut/release",
  "type": "module",
  "version": "0.0.1",
  "description": "Release orchestration scripts (auto-changeset + release) for Walnut Admin monorepo",
  "license": "MIT",
  "bin": {
    "walnut-auto-changeset": "./bin/auto-changeset.mjs",
    "walnut-release": "./bin/release.mjs"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "walnut": {
    "platform": "any",
    "type": "tooling",
    "runtime": "none"
  }
}
