{
  "name": "@walnut/commitlint-config",
  "type": "module",
  "version": "0.0.1",
  "description": "Shared commitlint configuration for Walnut Admin monorepo",
  "license": "MIT",
  "exports": {
    ".": "./index.mjs"
  },
  "main": "./index.mjs",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "echo 'config: pure source, no type check needed'"
  },
  "dependencies": {
    "@commitlint/config-conventional": "catalog:"
  },
  "devDependencies": {
    "eslint": "catalog:"
  },
  "walnut": {
    "platform": "any",
    "type": "tooling",
    "runtime": "none"
  }
}
