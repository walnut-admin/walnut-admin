{
  "name": "@walnut/commitlint-config",
  "type": "module",
  "version": "0.0.1",
  "description": "共享 commitlint 规则：type 白名单、scope 必填、scope 必须是 workspace 包名或基础设施 scope。根的 commitlint.config.ts 只做 `extends: ['@walnut/commitlint-config']`。",
  "license": "MIT",
  "exports": {
    ".": "./index.ts"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@commitlint/config-conventional": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@walnut/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "walnut": {
    "platform": "any",
    "type": "tooling",
    "runtime": "none"
  }
}
