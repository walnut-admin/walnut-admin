{
  "name": "@walnut/ui",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "UI component library for Walnut Admin",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "tsc --noEmit",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules"
  },
  "dependencies": {
    "@vueuse/core": "catalog:",
    "@walnut/core": "workspace:*",
    "@walnut/shared": "workspace:*",
    "compare-versions": "catalog:",
    "cropperjs": "catalog:",
    "driver.js": "catalog:",
    "echarts": "catalog:",
    "highlight.js": "catalog:",
    "lodash-es": "catalog:",
    "markdown-it": "catalog:",
    "naive-ui": "catalog:",
    "pinia": "catalog:",
    "sortablejs": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
