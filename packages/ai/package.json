    "@walnut/core": "workspace:*",
    "@walnut/shared": "workspace:*",
    "@walnut/ui": "workspace:*",
    "highlight.js": "catalog:",
    "markdown-it": "catalog:",
    "naive-ui": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
