{
  "name": "@walnut/ai",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "AI chat panel subsystem for Walnut Admin",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "tsc --noEmit",
