    "@walnut/ui": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.6",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vite": "8.0.11",
    "vite-plugin-dts": "4.5.4"
