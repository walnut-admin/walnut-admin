{
  "name": "@walnut/core",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Generic composables and hooks for Walnut Admin",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "echo 'core: pure source, no build needed'",
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "tsc --noEmit",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules"
  },
  "dependencies": {
    "@vueuse/core": "catalog:",
    "@walnut/shared": "workspace:*",
    "naive-ui": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@types/lodash-es": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "easy-fns-ts": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
