{
  "name": "@walnut/http",
  "type": "module",
  "version": "0.0.1",
  "description": "Axios-based HTTP client — primarily browser, core logic is dual-runtime capable",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "echo 'http: pure source, no build needed'",
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "tsc --noEmit",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules"
  },
  "dependencies": {
    "@walnut/contract": "workspace:*",
    "axios": "catalog:",
    "lodash-es": "catalog:",
    "lru-cache": "catalog:",
    "nanoid": "catalog:"
  },
  "devDependencies": {
    "@types/lodash-es": "catalog:",
    "@walnut/eslint-config": "workspace:*",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "walnut": {
    "platform": "web",
    "type": "http",
    "runtime": ["dom", "vue"]
  }
}
