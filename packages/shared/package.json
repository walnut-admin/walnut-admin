{
  "name": "@walnut/shared",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Shared utilities, constants, types, crypto and storage for Walnut Admin",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./types/*": "./src/types/*.d.ts",
    "./*": "./src/*.ts"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "echo 'shared: pure source, no build needed'",
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "tsc --noEmit",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules"
  },
  "dependencies": {
    "@vueuse/core": "catalog:",
    "detectincognitojs": "catalog:",
    "idb": "catalog:",
    "js-base64": "catalog:",
    "lodash-es": "catalog:",
    "nanoid": "catalog:",
    "superjson": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@types/lodash-es": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "easy-fns-ts": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
