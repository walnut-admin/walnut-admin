{
  "name": "@walnut/axios",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Custom Axios HTTP client with interceptors for Walnut Admin",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "echo 'axios: pure source, no build needed'",
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "tsc --noEmit",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules"
  },
  "dependencies": {
    "@walnut/contract": "workspace:*",
    "axios": "catalog:",
    "lodash-es": "catalog:",
    "lru-cache": "catalog:",
    "nanoid": "catalog:"
  },
  "devDependencies": {
    "@types/lodash-es": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@walnut/eslint-config": "workspace:*",
    "easy-fns-ts": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
