{
  "name": "@walnut/axios",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Custom Axios HTTP client with interceptors for Walnut Admin",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "echo 'axios: pure source, no build needed'",
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "tsc --noEmit",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules"
  },
  "peerDependencies": {
    "axios": "1.16.0",
    "lodash-es": "^4.0.0",
    "lru-cache": "^10.0.0",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.0",
    "@vitejs/plugin-vue": "6.0.6",
    "easy-fns-ts": "2.1.1",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vite": "8.0.11",
    "vite-plugin-dts": "4.5.4"
  }
}
