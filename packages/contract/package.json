{
  "name": "@walnut/contract",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Shared types and constants contract between frontend and backend",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "echo 'contract: pure source, no build needed'",
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "tsc --noEmit",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules"
  },
  "dependencies": {
    "easy-fns-ts": "catalog:"
  },
  "devDependencies": {
    "rimraf": "catalog:",
    "typescript": "catalog:"
  }
}
