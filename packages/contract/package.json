{
  "name": "@walnut/contract",
  "type": "module",
  "version": "0.0.1",
  "description": "Shared types and constants contract between frontend and backend",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./*": {
      "source": "./src/*.ts",
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "require": "./dist/*.cjs",
      "default": "./dist/*.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "tsc --noEmit",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules"
  },
  "dependencies": {
    "easy-fns-ts": "catalog:"
  },
  "devDependencies": {
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
