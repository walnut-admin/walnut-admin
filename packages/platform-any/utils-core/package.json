{
  "name": "@walnut/utils",
  "type": "module",
  "version": "0.0.1",
  "description": "Pure JS utility functions — consumed by both frontend and backend",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./*": {
      "source": "./src/*.ts",
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "require": "./dist/*.cjs",
      "default": "./dist/*.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "types:check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules"
  },
  "dependencies": {
    "@walnut/contract": "workspace:*",
    "@walnut/types": "workspace:*",
    "js-base64": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@walnut/eslint-config": "workspace:*",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "walnut": {
    "platform": "any",
    "type": "utils",
    "runtime": "none"
  }
}
