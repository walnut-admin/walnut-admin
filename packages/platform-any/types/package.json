{
  "name": "@walnut/types",
  "type": "module",
  "version": "0.1.24",
  "description": "Frontend-only type declarations — 后端 0 消费（2026-11 决策 D6 实测：apps/server 的依赖与 import 都是 0）",
  "license": "MIT",
  "exports": {
    ".": "./src/index.d.ts",
    "./*": "./src/*.d.ts"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "echo 'types: pure source, no build needed'",
    "lint": "eslint . --concurrency=4",
    "lint:fix": "eslint . --fix --concurrency=4",
    "types:check": "tsc --noEmit",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules"
  },
  "devDependencies": {
    "@walnut/eslint-config": "workspace:*",
    "@walnut/tsconfig": "workspace:*",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "walnut": {
    "platform": "web",
    "type": "contract",
    "runtime": "none"
  }
}
